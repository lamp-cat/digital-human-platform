# 应用
APP_ENV=dev
PUBLIC_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000

# 数据库（开发默认 SQLite；生产用 PostgreSQL）
DATABASE_URL=sqlite:///./data/dhp.db
# DATABASE_URL=postgresql+psycopg://dhp:dhp@localhost:5432/dhp

# 对象存储（开发默认本地目录；生产用 MinIO/S3）
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET_PRIVATE=dhp-private
# S3_BUCKET_PUBLIC=dhp-public
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# 任务队列（开发默认进程内 worker）
JOB_RUNNER=inprocess
# REDIS_URL=redis://localhost:6379/0
JOB_TIMEOUT_SECONDS=120

# 导入限制
IMPORT_MAX_BYTES=104857600
IMPORT_MAX_TRIANGLES=120000
IMPORT_VALIDATE_TIMEOUT_SECONDS=60

# 视觉（浏览器端，无需服务端配置）
POSE_MODEL_PROVIDER=mediapipe
POSE_MIN_CONFIDENCE=0.5

# 安全
JWT_SECRET=dev-only-change-me
SIGNED_URL_TTL_SECONDS=600
IMPORT_RETENTION_DAYS=30
